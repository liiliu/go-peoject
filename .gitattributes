# 自动转换换行符规则

# 所有 Shell 脚本使用 LF
*.sh text eol=lf

# Bash 配置文件使用 LF
.bashrc text eol=lf
.bash_profile text eol=lf

# Go 源文件使用 LF
*.go text eol=lf

# Markdown 和配置文件使用 LF
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# 保持 Windows 批处理文件为 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.exe binary
